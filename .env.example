# Momoto notification service — local development template. Copy to .env.
# This file is the ONLY place SMTP credentials live now; momoto-core no longer has them.

# Port the service listens on. Render and friends inject PORT — read it from the env.
PORT=3002

# Shared secret every caller must send as `Authorization: Bearer <key>`.
#
# REQUIRED in any deployment. An open send endpoint is a spam relay and a phishing kit
# that signs its mail with your domain's reputation. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# It must match momoto-core's NOTIFY_API_KEY.
NOTIFY_API_KEY=

# ── SMTP ─────────────────────────────────────────────────────────────────────
# Leave SMTP_HOST unset in local development: with no transport configured the service
# logs the message it would have sent (`mail.unsent_no_smtp`), so verification and
# reset links stay clickable from the terminal without a mailbox. Setting SMTP_HOST
# makes the rest required — a half-filled config fails at boot rather than silently
# never sending.
#
# Hostinger's settings; confirm yours in hPanel → Emails. 465 is implicit TLS, 587
# upgrades via STARTTLS.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=contact@momotoldr.com
# SMTP_PASS=
#
# Optional display form for the From header; defaults to "Momoto <SMTP_USER>". Must
# contain a real address — a bare display name ("Momoto Team") produces a From header
# with no sender, which SMTP accepts and the recipient's provider discards.
# SMTP_FROM=Momoto <noreply@momotoldr.com>
#
# Optional. Set this when SMTP_FROM is a no-reply address, so replies still land in a
# mailbox someone reads — the beta invitation asks people to reply with feedback.
# SMTP_REPLY_TO=contact@momotoldr.com
#
# IP family used to reach the mail host: 4 (default), 6, or 0 for "whatever DNS says".
# The default matters on most PaaS hosts: mail providers behind Cloudflare publish an
# AAAA record, Node dials it first, and a container with no public IPv6 route fails
# every send with ENETUNREACH — which reads like the mail server being down. Railway is
# exactly this shape (IPv6 privately, IPv4-only egress). Only change this if you know
# your host has working IPv6 egress.
# SMTP_IP_FAMILY=4

# ── Queue behaviour ──────────────────────────────────────────────────────────
# Attempts before a message is given up on (and logged as notify.failed).
# NOTIFY_MAX_ATTEMPTS=3
# Base retry delay; grows linearly with the attempt number.
# NOTIFY_RETRY_DELAY_MS=30000
# Pause between consecutive sends, so a 50-invite wave doesn't trip a per-hour cap.
# NOTIFY_SEND_INTERVAL_MS=1000

# Reverse-proxy hops in front of this service, for correct client IPs in logs.
# TRUST_PROXY=1
